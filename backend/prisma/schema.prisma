generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Customer {
  id                    String                 @id @default(cuid())
  customerCode          String                 @unique
  fullName              String
  companyName           String?
  phone                 String                 @unique
  alternatePhone        String?
  email                 String?
  address               String?
  panVat                String?
  notes                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  feedback              CustomerFeedback[]
  ledger                CustomerLedger[]
  repairJobs            RepairJob[]
  sales                 Sale[]
  smsCampaignRecipients SmsCampaignRecipient[]
  smsMessages           SmsMessageLog[]
  salesReturns          SalesReturn[]
}

model RepairJob {
  id                      String                @id @default(cuid())
  jobNumber               String                @unique
  customerId              String
  status                  JobStatus             @default(RECEIVED)
  priority                String                @default("NORMAL")
  receivedDate            DateTime              @default(now())
  expectedDate            DateTime?
  deliveryDate            DateTime?
  createdBy               String?
  branch                  String?
  deviceType              String
  brand                   String
  model                   String
  serialNumber            String?
  processor               String?
  ram                     String?
  storage                 String?
  graphics                String?
  operatingSystem         String?
  windowsPassword         String?
  biosPassword            String?
  color                   String?
  charger                 Boolean               @default(false)
  battery                 Boolean               @default(false)
  bag                     Boolean               @default(false)
  mouse                   Boolean               @default(false)
  keyboard                Boolean               @default(false)
  adapter                 Boolean               @default(false)
  box                     Boolean               @default(false)
  otherAccessories        String?
  screenCondition         String?
  bodyCondition           String?
  liquidDamage            Boolean               @default(false)
  missingKeys             Boolean               @default(false)
  hingeBroken             Boolean               @default(false)
  physicalRemarks         String?
  complaint               String
  observation             String?
  diagnosis               String?
  technicianId            String?
  repairNotes             String?
  diagnosisFee            Float?
  estimatedCost           Float?
  labourCharge            Float                 @default(0)
  advanceAmount           Float                 @default(0)
  totalAmount             Float                 @default(0)
  balanceAmount           Float                 @default(0)
  invoiceNumber           String?
  warrantyDays            Int?
  warrantyExpiry          DateTime?
  internalNotes           String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  discount                Float                 @default(0)
  importantNoticeAccepted Boolean               @default(false)
  feedback                CustomerFeedback?
  ledger                  CustomerLedger[]
  diagnoses               Diagnosis[]
  payments                Payment[]
  attachments             RepairAttachment[]
  customer                Customer              @relation(fields: [customerId], references: [id])
  technician              Technician?           @relation(fields: [technicianId], references: [id])
  repairJobAccessories    RepairJobAccessory[]
  repairJobFieldValues    RepairJobFieldValue[]
  parts                   RepairPart[]
  repairPayments          RepairPayment[]
  timeline                RepairTimeline[]
  smsMessages             SmsMessageLog[]
}

model CustomerFeedback {
  id          String    @id @default(cuid())
  repairJobId String    @unique
  customerId  String
  token       String    @unique
  rating      Int?
  comment     String?
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  repairJob   RepairJob @relation(fields: [repairJobId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([token])
}

model RepairJobFieldValue {
  id            String      @id @default(cuid())
  repairJobId   String
  deviceFieldId String
  value         String?
  deviceField   DeviceField @relation(fields: [deviceFieldId], references: [id], onDelete: Cascade)
  repairJob     RepairJob   @relation(fields: [repairJobId], references: [id], onDelete: Cascade)

  @@unique([repairJobId, deviceFieldId])
}

model Diagnosis {
  id            String    @id @default(cuid())
  repairJobId   String
  diagnosis     String
  solution      String?
  estimatedCost Float?
  createdAt     DateTime  @default(now())
  repairJob     RepairJob @relation(fields: [repairJobId], references: [id])
}

model RepairTimeline {
  id          String    @id @default(cuid())
  repairJobId String
  status      String
  remarks     String?
  createdAt   DateTime  @default(now())
  repairJob   RepairJob @relation(fields: [repairJobId], references: [id])
}

model RepairPayment {
  id          String    @id @default(cuid())
  repairJobId String
  amount      Float
  paymentMode String?
  remarks     String?
  createdAt   DateTime  @default(now())
  repairJob   RepairJob @relation(fields: [repairJobId], references: [id])
}

model Payment {
  id          String    @id @default(cuid())
  repairJobId String
  amount      Float
  paymentMode String?
  remarks     String?
  createdAt   DateTime  @default(now())
  repairJob   RepairJob @relation(fields: [repairJobId], references: [id])
}

model RepairPart {
  id          String    @id @default(cuid())
  repairJobId String
  inventoryId String
  quantity    Int
  price       Float
  createdAt   DateTime  @default(now())
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  repairJob   RepairJob @relation(fields: [repairJobId], references: [id])
}

model RepairAttachment {
  id          String    @id @default(cuid())
  repairJobId String
  fileName    String
  fileUrl     String
  createdAt   DateTime  @default(now())
  repairJob   RepairJob @relation(fields: [repairJobId], references: [id])
}

model Technician {
  id             String      @id @default(cuid())
  fullName       String
  phone          String?
  email          String?
  address        String?
  specialization String?
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  repairJobs     RepairJob[]
}

model Inventory {
  id                  String               @id @default(cuid())
  itemCode            String               @unique
  itemName            String
  brand               String?
  model               String?
  category            String?
  quantity            Int                  @default(0)
  purchasePrice       Float                @default(0)
  sellingPrice        Float                @default(0)
  supplierId          String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  barcode             String?
  description         String?
  itemType            InventoryType        @default(SPARE_PART)
  location            String?
  status              String               @default("Active")
  unit                String               @default("PCS")
  minimumStock        Int                  @default(0)
  supplier            Supplier?            @relation(fields: [supplierId], references: [id])
  purchaseItems       PurchaseItem[]
  repairParts         RepairPart[]
  saleItems           SaleItem[]
  salesReturnItems    SalesReturnItem[]
  purchaseReturnItems PurchaseReturnItem[]

  @@index([supplierId])
  @@index([itemType])
  @@index([category])
}

model Supplier {
  id                    String                 @id @default(cuid())
  supplierCode          String                 @unique
  companyName           String
  contactPerson         String?
  phone                 String?
  email                 String?
  address               String?
  panVat                String?
  notes                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  inventories           Inventory[]
  purchases             Purchase[]
  smsCampaignRecipients SmsCampaignRecipient[]
  smsMessages           SmsMessageLog[]
  payments              SupplierPayment[]
  salesReturns          SalesReturn[]
  purchaseReturns       PurchaseReturn[]
}

model Purchase {
  id                    String            @id @default(cuid())
  purchaseNumber        String            @unique
  supplierId            String
  purchaseDate          DateTime          @default(now())
  totalAmount           Float             @default(0)
  notes                 String?
  createdAt             DateTime          @default(now())
  dueAmount             Float             @default(0)
  paidAmount            Float             @default(0)
  paymentMethod         String?           @default("CASH")
  supplierInvoiceNumber String?
  supplier              Supplier          @relation(fields: [supplierId], references: [id])
  items                 PurchaseItem[]
  payments              SupplierPayment[]
  returns               PurchaseReturn[]
}

model PurchaseItem {
  id            String               @id @default(cuid())
  purchaseId    String
  inventoryId   String
  quantity      Int
  purchasePrice Float
  total         Float
  inventory     Inventory            @relation(fields: [inventoryId], references: [id])
  purchase      Purchase             @relation(fields: [purchaseId], references: [id])
  returnItems   PurchaseReturnItem[]
}

model PurchaseReturn {
  id           String   @id @default(cuid())
  returnNumber String   @unique
  purchaseId   String?
  supplierId   String
  returnDate   DateTime @default(now())
  totalAmount  Float    @default(0)
  refundAmount Float    @default(0)
  refundMethod String   @default("SUPPLIER_CREDIT")
  reason       String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchase Purchase?            @relation(fields: [purchaseId], references: [id])
  supplier Supplier             @relation(fields: [supplierId], references: [id])
  items    PurchaseReturnItem[]

  @@index([purchaseId])
  @@index([supplierId])
  @@index([returnDate])
}

model PurchaseReturnItem {
  id               String  @id @default(cuid())
  purchaseReturnId String
  purchaseItemId   String?
  inventoryId      String
  quantity         Int
  purchasePrice    Float   @default(0)
  total            Float   @default(0)

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  purchaseItem   PurchaseItem?  @relation(fields: [purchaseItemId], references: [id])
  inventory      Inventory      @relation(fields: [inventoryId], references: [id])

  @@index([purchaseReturnId])
  @@index([purchaseItemId])
  @@index([inventoryId])
}

model PurchaseReturnSequence {
  id         Int      @id
  nextNumber Int      @default(1)
  updatedAt  DateTime @updatedAt
}

model SupplierPayment {
  id            String    @id @default(cuid())
  supplierId    String
  purchaseId    String?
  paymentDate   DateTime  @default(now())
  amount        Float
  paymentMethod String?   @default("CASH")
  remarks       String?
  createdAt     DateTime  @default(now())
  purchase      Purchase? @relation(fields: [purchaseId], references: [id])
  supplier      Supplier  @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@index([purchaseId])
}

model Sale {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  customerId    String?
  saleDate      DateTime      @default(now())
  totalAmount   Float         @default(0)
  discount      Float         @default(0)
  grandTotal    Float         @default(0)
  createdAt     DateTime      @default(now())
  dueAmount     Float         @default(0)
  paidAmount    Float         @default(0)
  paymentMethod String?       @default("CASH")
  customer      Customer?     @relation(fields: [customerId], references: [id])
  items         SaleItem[]
  returns       SalesReturn[]
}

model SaleItem {
  id           String            @id @default(cuid())
  saleId       String
  inventoryId  String
  quantity     Int
  sellingPrice Float
  total        Float
  inventory    Inventory         @relation(fields: [inventoryId], references: [id])
  sale         Sale              @relation(fields: [saleId], references: [id])
  returnItems  SalesReturnItem[]
}

model SalesReturn {
  id           String   @id @default(cuid())
  returnNumber String   @unique
  saleId       String?
  customerId   String?
  supplierId   String?
  returnDate   DateTime @default(now())
  totalAmount  Float    @default(0)
  refundAmount Float    @default(0)
  refundMethod String   @default("CUSTOMER_CREDIT")
  reason       String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sale     Sale?             @relation(fields: [saleId], references: [id])
  customer Customer?         @relation(fields: [customerId], references: [id])
  supplier Supplier?         @relation(fields: [supplierId], references: [id])
  items    SalesReturnItem[]

  @@index([saleId])
  @@index([customerId])
  @@index([supplierId])
  @@index([returnDate])
}

model SalesReturnItem {
  id            String  @id @default(cuid())
  salesReturnId String
  saleItemId    String?
  inventoryId   String
  quantity      Int
  sellingPrice  Float   @default(0)
  total         Float   @default(0)

  salesReturn SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  saleItem    SaleItem?   @relation(fields: [saleItemId], references: [id])
  inventory   Inventory   @relation(fields: [inventoryId], references: [id])

  @@index([salesReturnId])
  @@index([saleItemId])
  @@index([inventoryId])
}

model User {
  id           String           @id @default(cuid())
  fullName     String
  username     String           @unique
  password     String
  role         String
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  smsCampaigns SmsCampaign[]
  smsMessages  SmsMessageLog[]
  permissions  UserPermission[]
}

model UserPermission {
  id         String   @id @default(cuid())
  userId     String
  permission String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([userId])
  @@index([permission])
}

model CustomerLedger {
  id          String     @id @default(cuid())
  customerId  String
  repairJobId String?
  particulars String
  debit       Float      @default(0)
  credit      Float      @default(0)
  balance     Float      @default(0)
  createdAt   DateTime   @default(now())
  customer    Customer   @relation(fields: [customerId], references: [id])
  repairJob   RepairJob? @relation(fields: [repairJobId], references: [id])
}

model CashBook {
  id          String   @id @default(cuid())
  particulars String
  debit       Float    @default(0)
  credit      Float    @default(0)
  balance     Float    @default(0)
  createdAt   DateTime @default(now())
}

model Expense {
  id            String   @id @default(cuid())
  title         String
  category      String?
  amount        Float
  remarks       String?
  expenseDate   DateTime @default(now())
  createdAt     DateTime @default(now())
  paymentMethod String?  @default("CASH")
}

model DeviceType {
  id                    String                @id @default(cuid())
  name                  String                @unique
  active                Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  brands                Brand[]
  deviceTypeAccessories DeviceTypeAccessory[]
  deviceFields          DeviceTypeField[]
  deviceLayouts         DeviceTypeLayout[]
}

model DeviceTypeLayout {
  id           String     @id @default(cuid())
  deviceTypeId String
  fieldKey     String
  fieldLabel   String
  visible      Boolean    @default(true)
  required     Boolean    @default(false)
  displayOrder Int        @default(0)
  columnSpan   Int        @default(1)
  deviceType   DeviceType @relation(fields: [deviceTypeId], references: [id], onDelete: Cascade)

  @@unique([deviceTypeId, fieldKey])
}

model DeviceField {
  id                   String                @id @default(cuid())
  name                 String
  fieldType            String
  category             String                @default("DEVICE_INFORMATION")
  placeholder          String?
  required             Boolean               @default(false)
  active               Boolean               @default(true)
  displayOrder         Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deviceTypeFields     DeviceTypeField[]
  repairJobFieldValues RepairJobFieldValue[]
}

model DeviceTypeField {
  id            String      @id @default(cuid())
  deviceTypeId  String
  deviceFieldId String
  visible       Boolean     @default(true)
  required      Boolean     @default(false)
  displayOrder  Int         @default(0)
  columnSpan    Int         @default(1)
  deviceField   DeviceField @relation(fields: [deviceFieldId], references: [id])
  deviceType    DeviceType  @relation(fields: [deviceTypeId], references: [id])

  @@unique([deviceTypeId, deviceFieldId])
}

model Brand {
  id           String      @id @default(cuid())
  name         String
  active       Boolean     @default(true)
  deviceTypeId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deviceType   DeviceType? @relation(fields: [deviceTypeId], references: [id])
}

model Accessory {
  id           String                @id @default(cuid())
  name         String                @unique
  active       Boolean               @default(true)
  displayOrder Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  deviceTypes  DeviceTypeAccessory[]
  repairJobs   RepairJobAccessory[]
}

model DeviceTypeAccessory {
  id           String     @id @default(cuid())
  deviceTypeId String
  accessoryId  String
  visible      Boolean    @default(true)
  required     Boolean    @default(false)
  displayOrder Int        @default(0)
  accessory    Accessory  @relation(fields: [accessoryId], references: [id], onDelete: Cascade)
  deviceType   DeviceType @relation(fields: [deviceTypeId], references: [id], onDelete: Cascade)

  @@unique([deviceTypeId, accessoryId])
}

model RepairJobAccessory {
  id          String    @id @default(cuid())
  repairJobId String
  accessoryId String
  received    Boolean   @default(false)
  remarks     String?
  accessory   Accessory @relation(fields: [accessoryId], references: [id], onDelete: Cascade)
  repairJob   RepairJob @relation(fields: [repairJobId], references: [id], onDelete: Cascade)

  @@unique([repairJobId, accessoryId])
}

model BillSequence {
  id         Int      @id
  nextNumber Int      @default(1)
  updatedAt  DateTime @updatedAt
}

model SalesReturnSequence {
  id         Int      @id
  nextNumber Int      @default(1)
  updatedAt  DateTime @updatedAt
}

model CompanySettings {
  id                      String   @id @default("company")
  companyName             String
  address                 String?
  phone                   String?
  email                   String?
  panVat                  String?
  website                 String?
  logoUrl                 String?
  invoiceFooter           String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  excelBackupEnabled      Boolean  @default(false)
  googleDriveEmail        String?
  googleDriveFolderId     String?
  repairExcelEnabled      Boolean  @default(true)
  salesExcelEnabled       Boolean  @default(true)
  purchaseExcelEnabled    Boolean  @default(true)
  googleDriveRefreshToken String?
  googleClientId          String?
  googleClientSecret      String?
}

model PaymentMethod {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([sortOrder])
}

model SystemSettings {
  id                  String   @id @default("system")
  currency            String   @default("NPR")
  currencySymbol      String   @default("Rs.")
  dateFormat          String   @default("DD/MM/YYYY")
  timeZone            String   @default("Asia/Kathmandu")
  defaultWarrantyDays Int      @default(0)
  enableNotifications Boolean  @default(true)
  allowNegativeStock  Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model CustomerLayoutField {
  id           String   @id @default(cuid())
  fieldKey     String   @unique
  fieldLabel   String
  visible      Boolean  @default(true)
  displayOrder Int      @default(0)
  columnSpan   Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ReceivingPrintLayoutField {
  id           String   @id @default(cuid())
  documentType String
  fieldKey     String
  fieldLabel   String
  visible      Boolean  @default(true)
  displayOrder Int      @default(0)
  columnSpan   Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  fontSize     Float    @default(11)
  marginMm     Float    @default(1.5)

  @@unique([documentType, fieldKey])
}

model ReceivingPrintSetting {
  id           String   @id @default(cuid())
  documentType String   @unique
  widthMm      Float    @default(70)
  heightMm     Float    @default(35)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ReceivingPrinterSetting {
  id             String   @id @default(cuid())
  voucherPrinter String?
  stickerPrinter String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SmsSetting {
  id         String   @id @default("sms")
  enabled    Boolean  @default(false)
  provider   String   @default("SOCIAIR")
  apiToken   String?
  senderId   String?
  apiBaseUrl String?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}

model FeedbackSetting {
  id              String   @id @default("feedback")
  feedbackPageUrl String?
  websiteUrl      String?
  facebookPageUrl String?
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}

model SmsTemplate {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  message   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SmsMessageLog {
  id                String     @id @default(cuid())
  customerId        String?
  repairJobId       String?
  userId            String?
  phone             String
  message           String
  templateCode      String?
  provider          String?
  status            String     @default("PENDING")
  providerMessageId String?
  providerResponse  String?
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime   @default(now())
  supplierId        String?
  customer          Customer?  @relation(fields: [customerId], references: [id])
  repairJob         RepairJob? @relation(fields: [repairJobId], references: [id])
  supplier          Supplier?  @relation(fields: [supplierId], references: [id])
  user              User?      @relation(fields: [userId], references: [id])

  @@index([customerId])
  @@index([repairJobId])
  @@index([userId])
  @@index([phone])
  @@index([status])
  @@index([createdAt])
  @@index([supplierId])
}

model SmsCampaign {
  id              String                 @id @default(cuid())
  name            String
  message         String
  status          String                 @default("DRAFT")
  totalRecipients Int                    @default(0)
  sentCount       Int                    @default(0)
  failedCount     Int                    @default(0)
  createdById     String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  createdBy       User?                  @relation(fields: [createdById], references: [id])
  recipients      SmsCampaignRecipient[]

  @@index([createdById])
  @@index([status])
  @@index([createdAt])
}

model SmsCampaignRecipient {
  id                String      @id @default(cuid())
  campaignId        String
  customerId        String?
  phone             String
  customerName      String?
  status            String      @default("PENDING")
  providerMessageId String?
  providerResponse  String?
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime    @default(now())
  supplierId        String?
  campaign          SmsCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer          Customer?   @relation(fields: [customerId], references: [id])
  supplier          Supplier?   @relation(fields: [supplierId], references: [id])

  @@index([campaignId])
  @@index([customerId])
  @@index([phone])
  @@index([status])
  @@index([supplierId])
}

model InventoryCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([sortOrder])
}

enum InventoryType {
  PRODUCT
  SPARE_PART
  CONSUMABLE
}

enum JobStatus {
  RECEIVED
  DIAGNOSIS
  WAITING_APPROVAL
  IN_PROGRESS
  WAITING_PARTS
  READY
  DELIVERED
  CANCELLED
  NOT_REPAIRABLE
}
